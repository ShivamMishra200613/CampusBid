# For local development with Vite proxy or Docker Compose with Nginx:
VITE_API_URL=/api/v1

# For production deployment on Vercel pointing to Render:
# VITE_API_URL=https://campusbid-api.onrender.com/api/v1

# Optional Socket.IO URL override (defaults automatically to the origin of VITE_API_URL):
# VITE_SOCKET_URL=https://campusbid-api.onrender.com
