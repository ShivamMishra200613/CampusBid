    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update Current Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alex Mercer\",\n  \"phone\": \"+91 98765 43210\",\n  \"classBranch\": \"D12C / EXTC\",\n  \"bio\": \"Electronics student and enthusiast.\",\n  \"notificationPreferences\": {\n    \"outbidAlerts\": true,\n    \"auctionEndingAlerts\": true,\n    \"newMessageAlerts\": false\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        }
      ]
    },
    {
      "name": "Products & Auctions",
      "item": [
        {
          "name": "Browse Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?category=all&status=live&sort=ending_soon",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "category", "value": "all" },
                { "key": "status", "value": "live" },
                { "key": "sort", "value": "ending_soon" }
              ]
            }
          }
        },
        {
          "name": "Get Product Details",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
          }
        },
        {
          "name": "Get My Listings",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/mine", "host": ["{{baseUrl}}"], "path": ["products", "mine"] }
          }
        },
        {
          "name": "Create Listing",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Arduino Uno Starter Kit\",\n  \"category\": \"electronics\",\n  \"condition\": \"like-new\",\n  \"description\": \"Complete starter kit for robotics experiments.\",\n  \"startingBid\": 1200,\n  \"minIncrement\": 50,\n  \"duration\": \"3d\",\n  \"images\": [\"https://images.unsplash.com/photo-1553406830-ef2513450d76?w=600\"],\n  \"isDraft\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Update Listing",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Arduino Uno Starter Kit (Updated)\",\n  \"description\": \"Complete kit with additional jumper wires and sensors.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
          }
        },
        {
          "name": "Publish Draft Listing",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/products/{{productId}}/publish", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}", "publish"] }
          }
        },
        {
          "name": "Report Listing",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Item violates campus auction guidelines.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/products/{{productId}}/report", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}", "report"] }
          }
        },
        {
          "name": "Delete Listing",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
          }
        }
      ]
    },
    {
      "name": "Bids",
      "item": [
        {
          "name": "Place Bid",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1350\n}"
            },
            "url": { "raw": "{{baseUrl}}/products/{{productId}}/bids", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}", "bids"] }
          }
        },
        {
          "name": "Get Product Bid History",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/{{productId}}/bids", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}", "bids"] }
          }
        },
        {
          "name": "Get My Bids",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/bids/my-bids?filter=all", "host": ["{{baseUrl}}"], "path": ["bids", "my-bids"], "query": [{ "key": "filter", "value": "all" }] }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/notifications", "host": ["{{baseUrl}}"], "path": ["notifications"] }
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/notifications/{{notificationId}}/read", "host": ["{{baseUrl}}"], "path": ["notifications", "{{notificationId}}", "read"] }
          }
        },
        {
          "name": "Mark All Read",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/notifications/read-all", "host": ["{{baseUrl}}"], "path": ["notifications", "read-all"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Platform Analytics",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] }
