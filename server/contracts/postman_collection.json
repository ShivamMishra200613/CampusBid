          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/listings/pending", "host": ["{{baseUrl}}"], "path": ["admin", "listings", "pending"] }
          }
        },
        {
          "name": "Moderate Listing",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/listings/{{productId}}/moderate", "host": ["{{baseUrl}}"], "path": ["admin", "listings", "{{productId}}", "moderate"] }
          }
        },
        {
          "name": "Get Reports",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/reports", "host": ["{{baseUrl}}"], "path": ["admin", "reports"] }
          }
        },
        {
          "name": "Resolve Report",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionAction\": \"remove_listing\",\n  \"notes\": \"Listing removed due to guideline violation.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/reports/{{reportId}}/resolve", "host": ["{{baseUrl}}"], "path": ["admin", "reports", "{{reportId}}", "resolve"] }
          }
        },
        {
          "name": "List Users",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/users?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        },
        {
          "name": "Suspend User",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}/suspend", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}", "suspend"] }
          }
        },
        {
          "name": "Unsuspend User",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }] },
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}/unsuspend", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}", "unsuspend"] }
          }
        }
      ]
    }
  ]
